{
  "private": true,
  "name": "t3-digital-credential-wallet",
  "version": "3.0.0",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "start": "npx expo start --dev-client -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "prettier --check ./app ./App.tsx && npm run compile",
    "lint:fix": "prettier --write ./app ./App.tsx && npm run compile",
    "format": "prettier --write .",
    "test": "npm run lint:fix && npm run test-jest && npm run test-node",
    "test-jest": "jest --config jest.config.ts --runInBand --detectOpenHandles --forceExit",
    "test-node": "node --import=tsx --test test-node/*",
    "coverage": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --config jest.config.coverage.ts --runInBand --detectOpenHandles --forceExit",
    "coverage:open": "npm run coverage && open coverage/lcov-report/index.html",
    "compile": "tsc --noEmit -p tsconfig.json && echo ✓ Passed TS compile check",
    "fix-deps": "npx expo install --check",
    "prebuild:ios": "EXPO_NO_TELEMETRY=1 EXPO_NO_GIT_STATUS=1 npx expo prebuild --clean -p ios",
    "prebuild:android": "EXPO_NO_TELEMETRY=1 EXPO_NO_GIT_STATUS=1 npx expo prebuild --clean -p android",
    "test:ui:ios": "maestro test .maestro/lock-unlock-wallet.yaml --env APP_ID=edu.mit.eduwallet",
    "test:ui:android": "maestro test .maestro/lock-unlock-wallet.yaml --env APP_ID=app.lcw",
    "test:ui": "maestro test .maestro/lock-unlock-wallet.yaml --config .maestro/config.yaml"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "@unimodules/core",
          "@unimodules/react-native-adapter"
        ]
      },
      "ios": {
        "exclude": [
          "@unimodules/core",
          "@unimodules/react-native-adapter"
        ]
      }
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-keyboard-aware-scroll-view",
          "react-native-securerandom"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "dependencies": {
    "@babel/runtime": "^7.27.6",
    "@digitalcredentials/issuer-registry-client": "^4.0.0",
    "@expo-google-fonts/arimo": "^0.2.3",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/roboto-mono": "^0.2.2",
    "@expo-google-fonts/source-sans-pro": "^0.2.3",
    "@expo/vector-icons": "^15.1.1",
    "@interop/data-integrity-core": "^6.1.2",
    "@interop/data-integrity-proof": "^3.2.2",
    "@interop/did-method-key": "^7.1.0",
    "@interop/did-web-resolver": "^6.1.1",
    "@interop/ed25519-signature": "^7.0.1",
    "@interop/ed25519-verification-key": "^7.0.1",
    "@interop/ezcap": "^7.1.1",
    "@interop/lru-memoize": "^4.0.3",
    "@interop/security-document-loader": "^9.2.2",
    "@interop/vc": "^11.0.2",
    "@interop/verifier-core": "^3.0.1",
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "^1.10.0",
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/hooks": "^3.0.0",
    "@react-native-documents/picker": "^12.0.1",
    "@react-navigation/bottom-tabs": "^6.0.7",
    "@react-navigation/native": "^6.0.1",
    "@react-navigation/stack": "^6.0.1",
    "@wallet.storage/fetch-client": "^1.3.0",
    "expo": "^54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.18",
    "handlebars": "^4.7.8",
    "html-entities": "^2.3.2",
    "json-canonicalize": "^1.0.4",
    "jsonpath-plus": "^10.3.0",
    "moment": "^2.29.1",
    "query-string": "^7.1.0",
    "react": "19.1.0",
    "react-async-hook": "^4.0.0",
    "react-native": "0.81.5",
    "react-native-base64": "^0.2.1",
    "react-native-circular-progress": "^1.3.7",
    "react-native-device-info": "^10.12.0",
    "react-native-dropdown-picker": "^5.4.2",
    "react-native-elements": "^3.4.2",
    "react-native-file-logger": "^0.4.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^1.8.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.4",
    "react-native-keychain": "^10.0.0",
    "react-native-markdown-display": "^7.0.0-alpha.2",
    "react-native-outside-press": "^1.1.0",
    "react-native-paper": "^4.12.3",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-share": "^10.0.2",
    "react-native-storage": "^1.0.1",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-uuid": "^2.0.1",
    "react-native-vision-camera": "4.7.3",
    "react-native-walkthrough-tooltip": "^1.6.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets-core": "^1.6.0",
    "rn-animated-ellipsis": "^2.1.3",
    "tar-stream": "^3.2.0",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "@testing-library/react-native": "^13.3.3",
    "@types/crypto-js": "^4.1.1",
    "@types/jest": "^29.5.5",
    "@types/react": "~19.1.17",
    "@types/tar-stream": "^3.1.4",
    "@types/uuid": "^10.0.0",
    "assert": "^2.1.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "jest": "^29.6.3",
    "jest-expo": "~54.0.0",
    "prettier": "^3.6.2",
    "process": "^0.11.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-redux": "^9.1.2",
    "react-test-renderer": "19.1.0",
    "stream-browserify": "^3.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "url": "^0.11.4",
    "util": "^0.12.5"
  }
}
